# Copy this file to .env and fill in YOUR OWN values.
# .env is git-ignored: your keys never leave your machine.

# --- DataChat's own Postgres (needs the pgvector extension) ---
DATABASE_URL=postgresql://datachat:datachat@localhost:5432/datachat
REDIS_URL=redis://localhost:6379/0

# Encrypts stored database passwords and LLM keys. Generate with: datachat-agent gen-secret
SECRET_KEY=

# --- LLM: bring your own key ---
# Any OpenAI-compatible endpoint works. Pick ONE block and uncomment it.
LLM_PROVIDER=openai_compatible

# Groq (free tier): https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# OpenRouter (models ending in :free): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# Ollama (local, no key): https://ollama.com  then: ollama pull qwen2.5-coder:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# Claude: set LLM_PROVIDER=anthropic, leave LLM_BASE_URL empty
# LLM_MODEL=claude-sonnet-5-5

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings (local and free by default) ---
# local: runs on your CPU, downloads ~70 MB once. openai_compatible: uses EMBED_BASE_URL/EMBED_API_KEY
# (falls back to the LLM settings).
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's vector size. Changing it later means re-creating the vector tables.
EMBED_DIM=384
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Limits on every query against a customer database ---
# SQL_TIMEOUT_SECONDS=10
# SQL_MAX_ROWS=500
# SQL_MAX_RESPONSE_BYTES=5000000
